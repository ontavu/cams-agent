# The image builds from the sources and nothing else.
.git
.github
.claude
/cams-agent
/cams-cli
*.test
*.out
*.prof

# A workspace names modules outside the context, and go refuses to build in
# one whose modules it cannot find. The image builds against the tagged
# versions go.mod requires, as ci/check.sh does with GOWORK=off.
go.work
go.work.sum
